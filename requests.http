@base = http://localhost:3000/api

### Проверка сервера
GET {{base}}/health

### Все категории
GET {{base}}/categories

### Создать категорию
POST {{base}}/categories
Content-Type: application/json

{ "name": "Яйца" }

### Все товары
GET {{base}}/products

### Товары категории 1
GET {{base}}/products?category_id=1

### Один товар
GET {{base}}/products/1

### Создать товар
POST {{base}}/products
Content-Type: application/json

{
  "category_id": 1,
  "farm_id": 1,
  "unit_id": 1,
  "name": "Свёкла",
  "price": 64.5,
  "pack_size": 1,
  "stock": 60
}

### Скрыть товар
DELETE {{base}}/products/1